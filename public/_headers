# Data files carry the release version in their path, so their contents can
# never change. That makes them safely immutable, and makes it impossible for
# a client to pair a new manifest with a chunk cached from a previous release
# — which would search the wrong range and report an existing UPRN as missing.
/d/*
  Cache-Control: public, max-age=31536000, immutable

# The pointer to the current release. Short-lived by design: this is what makes
# a refresh visible, so it must not be cached for long.
/version.json
  Cache-Control: public, max-age=300, must-revalidate
