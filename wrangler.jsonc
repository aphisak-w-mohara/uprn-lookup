{
  "name": "uprn-lookup",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // Chunks are not in git. Refuse to deploy a checkout that has not fetched
  // them: a Cloudflare Workers Build did exactly that on 2026-10-01.
  "build": { "command": "./tools/fetch-data.sh --check" },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "kv_namespaces": [
    {
      "binding": "UPRN_CACHE",
      "id": "9ee76e84d461499fab62790ffe98e086"
    }
  ],
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
